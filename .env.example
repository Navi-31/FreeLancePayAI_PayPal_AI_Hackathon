# ==============================================================================
# FREELANCEPAY AI — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to `.env` or `.env.local` for local execution.
# NEVER commit `.env` or production credentials to source control.

# Application Environment
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 1. FIREBASE CONFIGURATION (Google Cloud Firestore & Storage)
# ------------------------------------------------------------------------------
# Firebase Admin SDK (Server-Side Private Credentials):
FIREBASE_PROJECT_ID="freelancepay-ai"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-fbsvc@freelancepay-ai.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY_ID="placeholder_firebase_private_key_id"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET="freelancepay-ai.firebasestorage.app"

# Firebase Client Web SDK (Public Configuration):
NEXT_PUBLIC_FIREBASE_API_KEY="placeholder_web_api_key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="freelancepay-ai.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="freelancepay-ai"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="freelancepay-ai.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="placeholder_messaging_sender_id"
NEXT_PUBLIC_FIREBASE_APP_ID="placeholder_web_app_id"

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SECURITY SECRETS
# ------------------------------------------------------------------------------
# High-entropy secret key for JWT session signing (HS256)
# Generate with: openssl rand -base64 32
JWT_SECRET="replace_with_high_entropy_jwt_secret_min_32_characters_random"

# Session cookie duration in seconds (Default: 7 days = 604800)
SESSION_MAX_AGE_SECONDS=604800

# ------------------------------------------------------------------------------
# 3. OFFLINE / DEMO FALLBACK
# ------------------------------------------------------------------------------
# Set to "true" to enable seamless client localStorage fallback when offline (default: "false")
ENABLE_OFFLINE_DEMO_FALLBACK="false"

# ------------------------------------------------------------------------------
# 4. EXTERNAL INTEGRATIONS (Optional / Required for live rails)
# ------------------------------------------------------------------------------
# PayPal Commerce Platform Credentials (Phase 4B):
PAYPAL_CLIENT_ID="placeholder_paypal_client_id"
PAYPAL_CLIENT_SECRET="placeholder_paypal_client_secret"
PAYPAL_BASE_URL="https://api-m.sandbox.paypal.com"
PAYPAL_WEBHOOK_ID="placeholder_paypal_webhook_id"
PAYPAL_ENVIRONMENT="sandbox" # or "production"

# Stripe Connect Integration (Optional rail):
STRIPE_SECRET_KEY="placeholder_stripe_secret_key"
STRIPE_WEBHOOK_SECRET="placeholder_stripe_webhook_secret"

# ------------------------------------------------------------------------------
# 5. PRODUCTION AI PROVIDERS (Phase 4C)
# ------------------------------------------------------------------------------
# Provider mode: "auto" (detects available key), "gemini", "openai", or "fallback"
AI_PROVIDER="auto"

# Google Gemini API (Recommended for structured output):
GEMINI_API_KEY="placeholder_gemini_api_key"
GEMINI_MODEL="gemini-3.5-flash"

# OpenAI API:
OPENAI_API_KEY="placeholder_openai_api_key"
OPENAI_MODEL="gpt-4o-mini"
OPENAI_BASE_URL="https://api.openai.com/v1"

# ------------------------------------------------------------------------------
# 6. EMAIL DELIVERY & SYSTEM NOTIFICATIONS (Phase 4D)
# ------------------------------------------------------------------------------
# Email provider mode: "auto", "resend", "smtp", or "mock"
EMAIL_PROVIDER="auto"

# Resend API:
RESEND_API_KEY="placeholder_resend_api_key"

# Standard SMTP (Gmail, SendGrid, Amazon SES, Postmark):
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="placeholder_smtp_username@gmail.com"
SMTP_PASS="placeholder_smtp_app_password"

# Sender identity:
EMAIL_FROM="FreelancePay AI <notifications@freelancepay.ai>"

# ------------------------------------------------------------------------------
# 7. CRON & SYSTEM MAINTENANCE
# ------------------------------------------------------------------------------
# Secret token required to trigger automated background jobs via HTTP:
CRON_SECRET="dev_cron_secret_freelancepay_secure_key_10293"
