# ==============================================================================
# FREELANCEPAY AI — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to `.env` or `.env.local` for local execution.
# NEVER commit `.env` or production credentials to source control.

# Application Environment
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL / Prisma)
# ------------------------------------------------------------------------------
# PostgreSQL connection string:
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public
# Example for local development: postgresql://postgres:postgres@localhost:5432/freelancepay_db?schema=public
# For Supabase / Neon / AWS RDS: postgresql://<user>:<password>@<db-host>.com:5432/<dbname>?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/freelancepay_db?schema=public"

# Neon / Prisma direct unpooled connection string (used for schema migrations and DDL):
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5432/freelancepay_db?schema=public"

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SECURITY SECRETS
# ------------------------------------------------------------------------------
# High-entropy secret key for JWT session signing (HS256)
# Generate with: openssl rand -base64 32
JWT_SECRET="replace_with_high_entropy_jwt_secret_min_32_characters_random"

# Session cookie duration in seconds (Default: 7 days = 604800)
SESSION_MAX_AGE_SECONDS=604800

# ------------------------------------------------------------------------------
# 3. OFFLINE / DEMO FALLBACK
# ------------------------------------------------------------------------------
# Set to "true" to enable seamless client localStorage fallback when offline
ENABLE_OFFLINE_DEMO_FALLBACK="true"

# ------------------------------------------------------------------------------
# 4. EXTERNAL INTEGRATIONS (Optional / Required for live rails)
# ------------------------------------------------------------------------------
# PayPal Commerce Platform Credentials (Phase 4B):
PAYPAL_CLIENT_ID="placeholder_paypal_client_id"
PAYPAL_CLIENT_SECRET="placeholder_paypal_client_secret"
PAYPAL_BASE_URL="https://api-m.sandbox.paypal.com"
PAYPAL_WEBHOOK_ID="placeholder_paypal_webhook_id"
PAYPAL_ENVIRONMENT="sandbox" # or "production"

# Stripe Connect Integration (Optional rail):
STRIPE_SECRET_KEY="placeholder_stripe_secret_key"
STRIPE_WEBHOOK_SECRET="placeholder_stripe_webhook_secret"

# ------------------------------------------------------------------------------
# 5. PRODUCTION AI PROVIDERS (Phase 4C)
# ------------------------------------------------------------------------------
# Provider mode: "auto" (detects available key), "gemini", "openai", "neon", or "fallback"
AI_PROVIDER="auto"

# Google Gemini API (Recommended for structured output):
GEMINI_API_KEY="placeholder_gemini_api_key"
GEMINI_MODEL="gemini-3.8-flash"

# OpenAI / OpenAI-compatible provider:
OPENAI_API_KEY="placeholder_openai_api_key"
OPENAI_MODEL="gpt-4o-mini"
OPENAI_BASE_URL="https://api.openai.com/v1"

# Neon AI Gateway (OpenAI compatible, branches with database):
NEON_AI_GATEWAY_URL="placeholder_neon_ai_gateway_url"
NEON_AI_KEY="placeholder_neon_ai_key"

# ------------------------------------------------------------------------------
# 6. EMAIL DELIVERY, NOTIFICATIONS & BACKGROUND JOBS (Phase 4D)
# ------------------------------------------------------------------------------
# Email provider mode: "auto" (detects Resend key, falls back to mock/simulated), "resend", or "mock"
EMAIL_PROVIDER="auto"

# Resend API Key (Optional for production transactional emails):
RESEND_API_KEY="placeholder_resend_api_key"

# Default Sender Address:
EMAIL_FROM="FreelancePay AI <notifications@freelancepay.ai>"

# Cron / Background Job Trigger Secret (Required for /api/cron/process-jobs):
CRON_SECRET="dev_cron_secret_freelancepay_secure_key_10293"
